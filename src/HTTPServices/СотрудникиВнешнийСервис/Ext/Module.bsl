Функция EployeesGET(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Выборка = Справочники.Сотрудники.Выбрать();
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	
	Запись.ЗаписатьНачалоОбъекта();
	Пока Выборка.Следующий()Цикл
		Запись.ЗаписатьИмяСвойства(Строка(Выборка.Наименование));
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("Код");
		Запись.ЗаписатьЗначение(Строка(Выборка.Код));
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();
	
	Результат = Запись.Закрыть();
	Ответ.УстановитьТелоИзСтроки(Результат);
	Ответ.Заголовки.Вставить("Content-type","application/json; charset=utf-8");
	
	Возврат Ответ;
КонецФункции

Функция EployeesPOST(Запрос)
	Ответ = Новый HTTPСервисОтвет(204);
	
	Наименование = Запрос.ПараметрыЗапроса.Получить("name");
	Если Наименование = Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Ответ.УстановитьТелоИзСтроки("Не задан параметр Наименование");
		Ответ.Заголовки.Вставить("Content-type", "text/plain; charset=utf-8");
		Возврат Ответ;
	КонецЕсли;
	НовыйЭлемент = Справочники.Сотрудники.СоздатьЭлемент();
	НовыйЭлемент.Наименование = Наименование;
	НовыйЭлемент.Записать();
	
	Ответ.УстановитьТелоИзСтроки("Сотрудник записан");
	Ответ.Заголовки.Вставить("Content-type", "text/plain; charset=utf-8");
	
	Возврат Ответ;
КонецФункции



